@model VetKlinik.Web.Models.Entities.Appointment
@using VetKlinik.Web.Models.Enums

@{
    ViewData["Title"] = "Randevu Detayı";

    var badgeClass = Model.Status switch
    {
        AppointmentStatus.Pending => "bg-warning text-dark",
        AppointmentStatus.Approved => "bg-primary",
        AppointmentStatus.Completed => "bg-success",
        AppointmentStatus.Rejected => "bg-danger",
        AppointmentStatus.Cancelled => "bg-secondary",
        _ => "bg-light text-dark"
    };

    var statusText = Model.Status switch
    {
        AppointmentStatus.Pending => "Bekliyor",
        AppointmentStatus.Approved => "Onaylandı",
        AppointmentStatus.Completed => "Tamamlandı",
        AppointmentStatus.Rejected => "Reddedildi",
        AppointmentStatus.Cancelled => "İptal Edildi",
        _ => Model.Status.ToString()
    };
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="fw-bold mb-0">Randevu #@Model.Id Detayı</h4>
                    <span class="badge @badgeClass fs-6">@statusText</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="text-muted small">Evcil Hayvan</div>
                            <div class="fw-semibold fs-5">@Model.Pet?.Name</div>
                            <div class="text-muted small">@Model.Pet?.Species - @Model.Pet?.Breed</div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Veteriner Hekim & Klinik</div>
                            <div class="fw-semibold fs-5">@Model.Veterinarian?.FullName</div>
                            <div class="text-muted small">@Model.Veterinarian?.Specialization • @Model.Veterinarian?.Clinic?.Name</div>
                        </div>

                        <hr class="my-2" />

                        <div class="col-md-4">
                            <div class="text-muted small">Tarih</div>
                            <div class="fw-semibold">@Model.AppointmentDate.ToString("dd.MM.yyyy")</div>
                        </div>

                        <div class="col-md-4">
                            <div class="text-muted small">Saat Aralığı</div>
                            <div class="fw-semibold">@Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm") (@Model.DurationMinutes dk)</div>
                        </div>

                        <div class="col-md-4">
                            <div class="text-muted small">Hizmet & Ücret</div>
                            <div class="fw-semibold">@Model.VetService?.Name — @Model.Price.ToString("N2") ₺</div>
                        </div>

                        <hr class="my-2" />

                        <div class="col-12">
                            <div class="text-muted small mb-1">Hasta Sahibi Notu</div>
                            <div class="p-3 bg-light rounded">
                                @(string.IsNullOrWhiteSpace(Model.OwnerNotes) ? "Not belirtilmemiş." : Model.OwnerNotes)
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.ExaminationNotes))
                        {
                            <div class="col-12">
                                <div class="text-muted small mb-1">Hekim Muayene Notu</div>
                                <div class="p-3 bg-success-subtle border border-success-subtle rounded">
                                    @Model.ExaminationNotes
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">← Randevularıma Dön</a>

                        @if (Model.Status == AppointmentStatus.Pending || Model.Status == AppointmentStatus.Approved)
                        {
                            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                                  onsubmit="return confirm('Bu randevuyu iptal etmek istediğinize emin misiniz?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger">Randevuyu İptal Et</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>