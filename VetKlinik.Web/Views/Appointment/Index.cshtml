@model IEnumerable<VetKlinik.Web.Models.Entities.Appointment>
@using VetKlinik.Web.Models.Enums

@{
    ViewData["Title"] = "Randevularım";
    var hasPets = ViewBag.HasPets as bool? ?? false;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Randevularım</h2>
            <p class="text-muted mb-0">Evcil hayvanlarınız için aldığınız tüm klinik randevularını buradan takip edebilirsiniz.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            + Yeni Randevu Al
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!hasPets)
    {
        <div class="card border-0 shadow-sm text-center p-5">
            <h5 class="fw-semibold">Henüz kayıtlı bir evcil hayvanınız yok</h5>
            <p class="text-muted">Randevu alabilmek için öncelikle evcil hayvanınızı sisteme kaydetmelisiniz.</p>
            <div>
                <a asp-controller="Pet" asp-action="Create" class="btn btn-primary">Evcil Hayvan Ekle</a>
            </div>
        </div>
    }
    else if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5">
            <h5 class="fw-semibold">Henüz bir randevunuz bulunmuyor</h5>
            <p class="text-muted">Size uygun veteriner hekimi ve saat dilimini seçerek hemen randevu oluşturabilirsiniz.</p>
            <div>
                <a asp-action="Create" class="btn btn-primary">İlk Randevunu Oluştur</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih & Saat</th>
                            <th>Evcil Hayvan</th>
                            <th>Veteriner Hekim</th>
                            <th>Hizmet</th>
                            <th>Ücret</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var badgeClass = item.Status switch
                            {
                                AppointmentStatus.Pending => "bg-warning text-dark",
                                AppointmentStatus.Approved => "bg-primary",
                                AppointmentStatus.Completed => "bg-success",
                                AppointmentStatus.Rejected => "bg-danger",
                                AppointmentStatus.Cancelled => "bg-secondary",
                                _ => "bg-light text-dark"
                            };

                            var statusText = item.Status switch
                            {
                                AppointmentStatus.Pending => "Bekliyor",
                                AppointmentStatus.Approved => "Onaylandı",
                                AppointmentStatus.Completed => "Tamamlandı",
                                AppointmentStatus.Rejected => "Reddedildi",
                                AppointmentStatus.Cancelled => "İptal Edildi",
                                _ => item.Status.ToString()
                            };

                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.AppointmentDate.ToString("dd.MM.yyyy")</div>
                                    <small class="text-muted">@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</small>
                                </td>
                                <td>
                                    <span class="fw-semibold">@item.Pet?.Name</span>
                                    <div class="small text-muted">@item.Pet?.Species</div>
                                </td>
                                <td>
                                    <div>@item.Veterinarian?.FullName</div>
                                    <small class="text-muted">@item.Veterinarian?.Clinic?.Name</small>
                                </td>
                                <td>
                                    <div>@item.VetService?.Name</div>
                                    <small class="text-muted">@item.DurationMinutes dk</small>
                                </td>
                                <td class="fw-semibold">@item.Price.ToString("N2") ₺</td>
                                <td>
                                    <span class="badge @badgeClass">@statusText</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        Detay
                                    </a>

                                    @if (item.Status == AppointmentStatus.Pending || item.Status == AppointmentStatus.Approved)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Bu randevuyu iptal etmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">İptal Et</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>