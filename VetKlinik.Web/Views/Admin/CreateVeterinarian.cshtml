@model VetKlinik.Web.Models.ViewModels.AdminVeterinarianCreateViewModel

@{
    ViewData["Title"] = "Yeni Veteriner Hekim Ekle";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Yeni Veteriner Hekim Ekle</h2>
                    <p class="text-muted mb-0">Hekim için kullanıcı hesabı oluşturulur ve seçilen hizmetler atanır.</p>
                </div>
                <a asp-action="Veterinarians" class="btn btn-outline-secondary">← Kadroya Dön</a>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CreateVeterinarian" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-semibold"></label>
                                <input asp-for="FullName" class="form-control" placeholder="Örn: Dr. Vet. Selin Yıldız" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Specialization" class="form-label fw-semibold"></label>
                                <input asp-for="Specialization" class="form-control" placeholder="Örn: Egzotik Hayvanlar ve Cerrahi" />
                                <span asp-validation-for="Specialization" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <input asp-for="Email" class="form-control" placeholder="vet.selin@vetklinik.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold"></label>
                                <input asp-for="Password" type="password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <input asp-for="Address" class="form-control" placeholder="Serdivan, Sakarya" />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Bio" class="form-label fw-semibold"></label>
                            <textarea asp-for="Bio" rows="2" class="form-control" placeholder="Kısa mesleki özgeçmiş..."></textarea>
                            <span asp-validation-for="Bio" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold d-block mb-2">Hekimin Verebileceği Hizmetler</label>
                            <div class="row g-2">
                                @for (int i = 0; i < Model.AvailableServices.Count; i++)
                                {
                                    <div class="col-md-6">
                                        <div class="form-check p-3 border rounded">
                                            <input type="hidden" asp-for="@Model.AvailableServices[i].ServiceId" />
                                            <input type="hidden" asp-for="@Model.AvailableServices[i].ServiceName" />
                                            <input type="hidden" asp-for="@Model.AvailableServices[i].DurationMinutes" />
                                            <input type="hidden" asp-for="@Model.AvailableServices[i].Price" />

                                            <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="@Model.AvailableServices[i].IsSelected" />
                                            <label class="form-check-label fw-semibold" asp-for="@Model.AvailableServices[i].IsSelected">
                                                @Model.AvailableServices[i].ServiceName
                                                <small class="text-muted d-block fw-normal">
                                                    @Model.AvailableServices[i].DurationMinutes dk • @Model.AvailableServices[i].Price.ToString("N2") ₺
                                                </small>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Veteriner Hekimi Kaydet</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}