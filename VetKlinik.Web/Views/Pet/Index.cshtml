@model IEnumerable<VetKlinik.Web.Models.Entities.Pet>
@{
    ViewData["Title"] = "Evcil Hayvanlarım";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Evcil Hayvanlarım</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Evcil Hayvan Ekle</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card shadow-sm text-center p-5">
        <div class="card-body">
            <h5 class="text-muted mb-3">Henüz kayıtlı bir evcil hayvanınız bulunmuyor.</h5>
            <p class="text-muted">Randevu oluşturabilmek için önce dostunuzun bilgilerini sisteme ekleyin.</p>
            <a asp-action="Create" class="btn btn-success">İlk Kaydı Oluştur</a>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var pet in Model)
        {
            var ageYears = DateTime.Today.Year - pet.BirthDate.Year;
            if (pet.BirthDate.Date > DateTime.Today.AddYears(-ageYears)) ageYears--;

            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(pet.PhotoUrl))
                    {
                        <img src="@pet.PhotoUrl" class="card-img-top" alt="@pet.Name" style="height: 220px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 220px;">
                            <span>Fotoğraf Yok</span>
                        </div>
                    }

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="card-title mb-0">@pet.Name</h5>
                            <span class="badge bg-info text-dark">@pet.Species</span>
                        </div>
                        <ul class="list-unstyled text-muted small mb-0">
                            <li><strong>Irk:</strong> @pet.Breed</li>
                            <li><strong>Doğum Tarihi:</strong> @pet.BirthDate.ToString("dd.MM.yyyy") (@(ageYears > 0 ? $"{ageYears} Yaş" : "1 Yaşından Küçük"))</li>
                            <li><strong>Kilo:</strong> @pet.WeightKg kg</li>
                        </ul>
                    </div>

                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@pet.Id" class="btn btn-outline-primary btn-sm">Düzenle</a>
                        <form asp-action="Delete" asp-route-id="@pet.Id" method="post" onsubmit="return confirm('@pet.Name kaydını silmek istediğinize emin misiniz?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Sil</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}