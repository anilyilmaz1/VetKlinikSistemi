@model VetKlinik.Web.Models.ViewModels.VetVaccinationEditViewModel

@{
    ViewData["Title"] = "Aşı Kaydını Düzenle";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Aşı Kaydını Düzenle</h2>
                    <p class="text-muted mb-0">Hasta: <strong>@Model.PetName</strong></p>
                </div>
                <a asp-action="Examine" asp-route-id="@Model.AppointmentId" class="btn btn-outline-secondary">← Muayeneye Dön</a>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="EditVaccination" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="AppointmentId" type="hidden" />
                        <input asp-for="PetName" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="VaccineName" class="form-label fw-semibold"></label>
                            <input asp-for="VaccineName" class="form-control" />
                            <span asp-validation-for="VaccineName" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="AdministeredDate" class="form-label fw-semibold"></label>
                                <input asp-for="AdministeredDate" type="date" class="form-control" />
                                <span asp-validation-for="AdministeredDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NextDueDate" class="form-label fw-semibold"></label>
                                <input asp-for="NextDueDate" type="date" class="form-control" />
                                <span asp-validation-for="NextDueDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-semibold"></label>
                            <textarea asp-for="Notes" rows="3" class="form-control"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Aşı Kaydını Güncelle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}